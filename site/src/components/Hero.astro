---
/**
 * 覆盖 Starlight 内置 Hero（见 astro.config.mjs 的 components 配置）。
 * 目前只有首页使用 hero frontmatter，因此这里的增强版视觉只作用于首页；
 * 若后续其它页面也需要 hero，会按 isLanding 走原有简洁排版。
 */

const { entry, id } = Astro.locals.starlightRoute;
const { title = entry.data.title, tagline, actions = [] } = entry.data.hero ?? {};
const BASE = import.meta.env.BASE_URL;
// 集合根 index.mdx 的 id 为空字符串
const isLanding = id === '' || id === 'index';

const withBase = (link: string) =>
	link.startsWith('/') || /^[a-z]+:/i.test(link) ? link : `${BASE}${link}`;

const metrics = [
	{ value: '15', label: '节课' },
	{ value: '6', label: '个模块' },
	{ value: '4', label: '类典型故障' },
	{ value: '0', label: '特权依赖' },
];
---

<header class:list={['lp-hero', { 'lp-hero--landing': isLanding }]}>
	<div class="lp-hero__glow" aria-hidden="true"></div>
	<div class="lp-hero__grid" aria-hidden="true"></div>

	<div class="lp-hero__inner">
		{isLanding && (
			<p class="lp-eyebrow">
				<span class="lp-dot" aria-hidden="true"></span>
				v0.1 · 内容已上线
			</p>
		)}

		<h1 id="_top" data-page-title class="lp-title" set:html={title} />

		{tagline && (
			<p class="lp-tagline" set:html={tagline} />
		)}

		{actions.length > 0 && (
			<div class="lp-actions">
				{actions.map(({ link, text, variant }) => (
					<a
						class:list={['lp-btn', variant === 'minimal' ? 'lp-btn--ghost' : 'lp-btn--solid']}
						href={withBase(link)}
					>
						{text}
						<svg class="lp-btn__icon" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
							<path
								d="M3 8h9M8.5 4.5 12 8l-3.5 3.5"
								fill="none"
								stroke="currentColor"
								stroke-width="1.6"
								stroke-linecap="round"
								stroke-linejoin="round"
							/>
						</svg>
					</a>
				))}
			</div>
		)}

		{isLanding && (
			<ul class="lp-metrics">
				{metrics.map(({ value, label }) => (
					<li>
						<span class="lp-metrics__value">{value}</span>
						<span class="lp-metrics__label">{label}</span>
					</li>
				))}
			</ul>
		)}
	</div>
</header>

<style>
	/* 首页：滴出的背景层会横向溢出，用 clip 兜住，避免出现横向滚动条 */
	:global(html[data-has-hero]) {
		overflow-x: clip;
	}

	.lp-hero {
		position: relative;
		isolation: isolate;
		/* 抵掉 ContentPanel 的上内边距，让英雄区贴着导航栏 */
		margin-block-start: -1.5rem;
		padding-block: clamp(3rem, 9vw, 6rem) clamp(2rem, 5vw, 3rem);
	}

	.lp-hero__inner {
		position: relative;
		z-index: 1;
		width: 100%;
		max-width: 60rem;
		margin-inline: auto;
		padding-inline: clamp(1.25rem, 4vw, 2.5rem);
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1.25rem;
		text-align: center;
	}

	/* 背景：两团低饱和光晕（出血到视口宽度） */
	.lp-hero__glow,
	.lp-hero__grid {
		position: absolute;
		inset-block: 0;
		inset-inline: calc(50% - 50vw);
		pointer-events: none;
	}

	.lp-hero__glow {
		z-index: -2;
		background:
			radial-gradient(46rem 26rem at 10% -12%, var(--lp-glow-a), transparent 72%),
			radial-gradient(40rem 24rem at 90% -14%, var(--lp-glow-b), transparent 74%);
	}

	/* 背景：细网格，向上收拢淡出 */
	.lp-hero__grid {
		z-index: -1;
		background-image:
			linear-gradient(to right, var(--lp-grid) 1px, transparent 1px),
			linear-gradient(to bottom, var(--lp-grid) 1px, transparent 1px);
		background-size: 64px 64px;
		mask-image: radial-gradient(ellipse 78% 62% at 50% 0%, #000 20%, transparent 76%);
	}

	.lp-eyebrow {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		margin: 0;
		padding: 0.3rem 0.75rem 0.3rem 0.6rem;
		border: 1px solid var(--lp-border);
		border-radius: 999px;
		background: var(--lp-surface);
		backdrop-filter: blur(8px);
		color: var(--lp-muted);
		font-size: var(--sl-text-xs);
		letter-spacing: 0.02em;
	}

	.lp-dot {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: var(--lp-accent);
		box-shadow: 0 0 0 3px color-mix(in srgb, var(--lp-accent) 22%, transparent);
	}

	.lp-title {
		margin: 0;
		margin-block-start: 0.25rem;
		max-width: 22ch;
		font-size: clamp(2rem, 6.2vw, 4.25rem);
		font-weight: 700;
		line-height: 1.06;
		letter-spacing: -0.03em;
		color: var(--lp-fg);
		background: linear-gradient(172deg, var(--lp-title-from) 18%, var(--lp-title-to) 96%);
		-webkit-background-clip: text;
		background-clip: text;
		-webkit-text-fill-color: transparent;
	}

	.lp-tagline {
		margin: 0;
		max-width: 42ch;
		color: var(--lp-muted);
		font-size: clamp(var(--sl-text-base), 0.5vw + 0.9rem, var(--sl-text-lg));
		line-height: 1.7;
	}

	.lp-actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.75rem;
		margin-block-start: 0.5rem;
	}

	.lp-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		padding: 0.7rem 1.3rem;
		border-radius: 999px;
		font-size: var(--sl-text-sm);
		font-weight: 600;
		text-decoration: none;
		transition:
			transform 0.18s ease,
			box-shadow 0.18s ease,
			background-color 0.18s ease,
			border-color 0.18s ease;
	}

	.lp-btn__icon {
		transition: transform 0.18s ease;
	}

	.lp-btn:hover .lp-btn__icon {
		transform: translateX(3px);
	}

	.lp-btn--solid {
		background: var(--lp-fg);
		color: var(--lp-surface-solid);
		box-shadow: 0 10px 24px -14px hsl(220 60% 4% / 0.7);
	}

	.lp-btn--solid:hover {
		transform: translateY(-1px);
		box-shadow: 0 14px 30px -14px hsl(220 60% 4% / 0.75);
	}

	.lp-btn--ghost {
		border: 1px solid var(--lp-border-strong);
		background: var(--lp-surface);
		color: var(--lp-fg);
		backdrop-filter: blur(8px);
	}

	.lp-btn--ghost:hover {
		transform: translateY(-1px);
		border-color: color-mix(in srgb, var(--lp-fg) 40%, transparent);
	}

	.lp-metrics {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: clamp(1.5rem, 6vw, 3.5rem);
		margin: clamp(1.5rem, 4vw, 2.5rem) 0 0;
		padding: clamp(1.25rem, 3vw, 1.75rem) 0 0;
		list-style: none;
		border-top: 1px solid var(--lp-border);
		width: min(100%, 44rem);
	}

	.lp-metrics li {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.15rem;
	}

	.lp-metrics__value {
		font-size: clamp(1.5rem, 2vw + 0.8rem, 2rem);
		font-weight: 650;
		line-height: 1.1;
		letter-spacing: -0.02em;
		font-variant-numeric: tabular-nums;
		color: var(--lp-fg);
	}

	.lp-metrics__label {
		font-size: var(--sl-text-xs);
		color: var(--lp-muted);
	}

	@media (prefers-reduced-motion: reduce) {
		.lp-btn,
		.lp-btn__icon {
			transition: none;
		}
	}
</style>
